{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es5",
    "allowJs": true,
    "declaration": true
  },
  "include": ["cypress.config.ts", 
              "./index.ts",
              "cypress/**/*.ts",
              "cypress/**/*.d.ts",
              "cypress-preset.ts"
            ],
  "exclude": ["node_modules"],
  "typeRoots": ["./node_modules/@types", "./cypress"]
}